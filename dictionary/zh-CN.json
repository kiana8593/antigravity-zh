      "selector": "[data-testid=\"customizations-marketplace\"] h2,[data-testid=\"customizations-marketplace\"] h3,[data-testid=\"customizations-installed\"] h2,[data-testid=\"customizations-installed\"] h3",
      "words": {
        "Plugins": "插件",
        "Skills": "技能",
        "Agents": "智能体",
        "Rules": "规则",
        "Hooks": "钩子",
        "Automations": "自动化",
        "MCP Servers": "MCP 服务器",
        "Google Workspace": "Google Workspace",
        "Build with Google": "使用 Google 构建"
      },
      "direct": true,
      "exclude": "[data-testid=\"customization-card\"]"
